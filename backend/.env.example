# Twilio account credentials (replace with values from your Twilio Console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_a_rotated_auth_token

# Twilio Verify > Services > Service SID (used for language-change SMS OTPs)
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: an SMS-capable Twilio sender number used by other direct-SMS features
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
